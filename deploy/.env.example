# ==========================================
# 環境変数テンプレート (.env.example)
# 実際に利用する際は、本ファイルをコピーして .env を作成してください。
# ==========================================

# 1. PostgreSQL 設定
POSTGRES_USER=dxadmin
POSTGRES_PASSWORD=YourSecurePassword123!
POSTGRES_DB=inventory_db

# 2. Cloudflare Tunnel 設定
# Cloudflare Zero Trust ダッシュボードで作成したTunnelのトークン
TUNNEL_TOKEN=eyJhIjoi...YourCloudflareTunnelToken...

# 3. 内部API共有トークン (Lambda - FastAPI間)
INTERNAL_API_TOKEN=dx-warehouse-secure-token-2026

