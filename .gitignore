.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 仮想環境
venv/
.venv/
ENV/
env/

# 3. データベース / コンテナデータ
pgdata/
*.sqlite3
*.db

# 4. クラウド同期ファイル / Google Drive
*.gdoc
