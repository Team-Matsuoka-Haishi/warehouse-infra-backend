# 1. 機密情報・環境変数 (絶対にコミットしない)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# 2. Python / FastAPI
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
